---
// Two-column figure: the work an AI assistant speeds up, beside the decisions that stay mine.
const helps = [
  'Finding where a value comes from',
  'Workflows, configuration and fixtures',
  'First drafts of screens, scripts and tests',
  'A second pair of eyes on a pull request',
];
const decides = [
  'What the change should actually do',
  'Which rules must never be broken',
  'Whether the evidence proves it works',
  'When it is safe to ship to real people',
];
---

<figure class="not-prose my-10">
  <div class="grid gap-3 sm:grid-cols-2">
    <div class="rounded-2xl border border-line bg-surface p-5">
      <p class="flex items-center gap-2 text-sm font-medium">
        <svg viewBox="0 0 24 24" class="size-5 text-accent" fill="currentColor" aria-hidden="true">
          <path d="M12 2c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7Z" />
          <path d="M19 15c.3 2 1 2.7 3 3-2 .3-2.7 1-3 3-.3-2-1-2.7-3-3 2-.3 2.7-1 3-3Z" opacity=".6" />
        </svg>
        AI speeds up
      </p>
      <ul class="mt-4 space-y-2.5 text-[15px] text-muted">
        {
          helps.map((item) => (
            <li class="flex gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent/60" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rounded-2xl border border-fg/80 bg-surface p-5">
      <p class="flex items-center gap-2 text-sm font-medium">
        <svg
          viewBox="0 0 24 24"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="8" r="3.5" />
          <path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5" />
        </svg>
        I decide
      </p>
      <ul class="mt-4 space-y-2.5 text-[15px] text-muted">
        {
          decides.map((item) => (
            <li class="flex gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-fg" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <figcaption class="mt-3 text-center text-sm text-muted">
    The assistant makes the work faster. The judgment calls stay with me.
  </figcaption>
</figure>
