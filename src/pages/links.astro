---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import { profile } from '~/data/profile';
import { social } from '~/data/social';
import portrait from '~/assets/azim.jpg';
---

<Base title="Links" description={`Where to find ${profile.name} online.`}>
  <div class="mx-auto max-w-md px-4 pt-12 sm:pt-16">
    <Image
      src={portrait}
      alt={`Portrait of ${profile.name}`}
      widths={[96, 192]}
      sizes="96px"
      class="size-24 rounded-full object-cover object-top"
    />
    <h1 class="mt-5 font-serif text-3xl font-semibold tracking-tight">{profile.name}</h1>
    <p class="mt-2 text-muted">{profile.headline}</p>
    <ul class="mt-8 space-y-3">
      <li>
        <a href="/" class="card flex items-center justify-between">
          <span><span class="font-medium">Website</span><span class="block text-sm text-muted">Projects and writing</span></span>
          <span aria-hidden="true" class="text-muted">→</span>
        </a>
      </li>
      {
        social.map((s) => (
          <li>
            {s.href ? (
              <a href={s.href} class="card flex items-center justify-between" rel="me noopener">
                <span>
                  <span class="font-medium">{s.label}</span>
                  <span class="block text-sm text-muted">{s.note}</span>
                </span>
                <span aria-hidden="true" class="text-muted">↗</span>
              </a>
            ) : (
              <div class="card">
                <span class="font-medium">{s.label}</span>
                <span class="block text-sm text-muted select-all">{s.note}</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Base>
