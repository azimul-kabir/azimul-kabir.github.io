---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import PostList from '~/components/PostList.astro';
import ThemedImage from '~/components/ThemedImage.astro';
import { profile } from '~/data/profile';
import { projects, featured } from '~/data/projects';
import { github } from '~/data/social';
import { blogPosts, formatMonth } from '~/lib/blog';
import { latestReleaseLabel, repoStats } from '~/lib/github';
import harmonyHero from '~/assets/harmony-hero.jpg';
import portrait from '~/assets/azim.jpg';

const posts = (await blogPosts()).slice(0, 3);
const harmonyProject = projects.find((p) => p.slug === 'harmony')!;
const others = projects.filter((p) => !p.featured && p !== harmonyProject).slice(0, 4);
const [actua, harmony] = await Promise.all([repoStats(featured.repo!), repoStats(harmonyProject.repo!)]);
const nowItems = profile.now.map((item) =>
  item.label === 'Building'
    ? {
        ...item,
        // The featured cards below describe both apps, so this only names the current releases.
        text: `${actua?.latestRelease ? `Actua ${actua.latestRelease}` : 'Actua'} and ${harmony?.latestRelease ? `Harmony ${harmony.latestRelease}` : 'Harmony'}, with the next releases on the way.`,
      }
    : item,
);
---

<Base>
  <section class="container-wide pt-12 pb-16 sm:pt-20 md:grid md:grid-cols-[1fr_auto] md:items-center md:gap-10">
    <Image
      src={portrait}
      alt={`Portrait of ${profile.name}`}
      widths={[96, 192, 320, 400]}
      sizes="(min-width: 768px) 192px, 96px"
      class="fade-up mb-6 size-24 rounded-full border border-line object-cover md:order-2 md:mb-0 md:size-48"
      loading="eager"
    />
    <div class="md:order-1">
      <p class="eyebrow fade-up">{profile.headline}</p>
      <h1 class="fade-up mt-4 font-serif text-[2.6rem] leading-[1.05] font-semibold tracking-tight sm:text-6xl">
        {profile.name}
      </h1>
      <p class="fade-up mt-6 max-w-2xl font-serif text-2xl leading-snug text-muted sm:text-[1.7rem]" style="animation-delay:80ms">
        I work in banking MIS by day and build <a href="/projects/actua" class="text-fg italic hover:text-accent">Actua</a>,
        an open-source budgeting app for Android, and{' '}
        <a href="/projects/harmony" class="text-fg italic hover:text-accent">Harmony</a>, a self-hosted music manager, by night.
      </p>
      <p class="fade-up mt-4 text-[15px] text-muted" style="animation-delay:140ms">
        <span class="block">Based in {profile.location}</span>
        <span class="block">Writing about building software and practical AI.</span>
      </p>
      <div class="fade-up mt-8 flex flex-wrap gap-3" style="animation-delay:200ms">
        <a href="/projects/actua" class="btn btn-primary">See Actua</a>
        <a href={`mailto:${profile.email}`} class="btn">Get in touch</a>
        <a href={github.href} class="btn" rel="me noopener">GitHub</a>
      </div>
    </div>
  </section>

  <section class="container-wide" aria-labelledby="now">
    <div class="flex items-baseline justify-between">
      <h2 id="now" class="eyebrow">Now</h2>
      <p class="text-xs text-muted">Updated {formatMonth(new Date(profile.nowUpdated))}</p>
    </div>
    <dl class="mt-4 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
      {
        nowItems.map((item) => (
          <div class="bg-surface p-5">
            <dt class="text-sm font-medium">{item.label}</dt>
            <dd class="mt-1 text-[15px] text-muted">{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container-wide mt-20" aria-labelledby="featured">
    <h2 id="featured" class="eyebrow">Featured projects</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {
        [
          { href: '/projects/actua', name: 'Actua', image: featured.image!.src, imageDark: featured.image!.srcDark, alt: featured.image!.alt, bg: 'bg-[#ede7fb] dark:bg-[#2a0f8a]', stats: actua, summary: featured.summary },
          { href: '/projects/harmony', name: 'Harmony', image: harmonyHero, imageDark: undefined, alt: harmonyProject.image!.alt, bg: 'bg-[#0b1215]', stats: harmony, summary: harmonyProject.summary },
        ].map((f) => (
          <a href={f.href} class="card flex flex-col overflow-hidden p-0">
            <ThemedImage
              src={f.image}
              srcDark={f.imageDark}
              alt={f.alt}
              widths={[480, 720, 1000]}
              sizes="(min-width: 1024px) 490px, (min-width: 768px) 50vw, 100vw"
              class:list={['aspect-[16/9] w-full object-cover object-left', f.bg]}
              loading="eager"
            />
            <div class="flex flex-1 flex-col p-5">
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <h3 class="font-serif text-2xl font-semibold">{f.name}</h3>
                <p class="text-sm text-muted">
                  {[latestReleaseLabel(f.stats), f.stats && `★ ${f.stats.stars}`].filter(Boolean).join(' · ')}
                </p>
              </div>
              <p class="mt-2 text-[15px] text-muted">{f.summary}</p>
              <p class="mt-auto pt-4 text-sm font-medium text-accent">Read the case study →</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container-wide mt-20" aria-labelledby="projects">
    <div class="flex items-baseline justify-between">
      <h2 id="projects" class="eyebrow">Other projects</h2>
      <a href="/projects" class="text-sm text-muted hover:text-fg">All projects →</a>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {others.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="container-wide mt-20" aria-labelledby="blog">
        <div class="flex items-baseline justify-between">
          <h2 id="blog" class="eyebrow">From the blog</h2>
          <a href="/blog" class="text-sm text-muted hover:text-fg">All posts →</a>
        </div>
        <div class="mt-4">
          <PostList posts={posts} />
        </div>
      </section>
    )
  }
</Base>
