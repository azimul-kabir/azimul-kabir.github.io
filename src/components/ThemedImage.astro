---
import type { ComponentProps } from 'astro/types';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// An <Image> with an optional dark-theme version. Both are rendered and CSS shows the one matching the
// site theme; the hidden one is lazy-loaded, so it isn't downloaded until the theme changes.
type Props = ComponentProps<typeof Image> & { src: ImageMetadata; srcDark?: ImageMetadata };
const { src, srcDark, class: className, loading, ...rest } = Astro.props;
---

{
  srcDark ? (
    <>
      <Image src={src} class:list={[className, 'dark:hidden']} loading={loading} {...rest} />
      <Image src={srcDark} class:list={[className, 'hidden dark:block']} loading="lazy" {...rest} />
    </>
  ) : (
    <Image src={src} class={className} loading={loading} {...rest} />
  )
}
