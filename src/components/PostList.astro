---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '~/lib/lab';

interface Props {
  posts: CollectionEntry<'lab'>[];
}
const { posts } = Astro.props;
---

<ul class="divide-y divide-line border-y border-line">
  {
    posts.map((post) => (
      <li>
        <a href={`/lab/${post.id}`} class="group flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-6">
          <time datetime={post.data.date.toISOString()} class="shrink-0 text-sm text-muted tabular-nums sm:w-28">
            {formatDate(post.data.date)}
          </time>
          <span>
            <span class="font-serif text-lg font-semibold group-hover:text-accent">{post.data.title}</span>
            <span class="mt-0.5 block text-[15px] text-muted">{post.data.description}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
