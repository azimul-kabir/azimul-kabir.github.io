---
// Header illustration for "The Journey of Actua": an Android phone showing budget categories,
// syncing both ways with a self-hosted Actual Budget server. Drawn with the site's colour tokens
// so it follows the light and dark themes.
// `bare` drops the caption and margins so the drawing can double as the post's thumbnail.
interface Props {
  bare?: boolean;
}
const { bare = false } = Astro.props;
---

<figure class:list={['not-prose', !bare && 'my-10']} aria-hidden={bare ? 'true' : undefined}>
  <svg viewBox="0 0 720 280" class="h-auto w-full" role="img" aria-labelledby="actua-art-title">
    <title id="actua-art-title">
      An Android phone showing budget categories, syncing both ways with a self-hosted Actual Budget server.
    </title>
    <defs>
      <pattern id="aa-dots" width="16" height="16" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1" style="fill: var(--line)" />
      </pattern>
    </defs>

    <rect x="0" y="0" width="720" height="280" rx="24" style="fill: var(--surface); stroke: var(--line)" />
    <rect x="1" y="1" width="718" height="278" rx="23" fill="url(#aa-dots)" opacity="0.7" />

    <!-- Phone -->
    <g>
      <rect x="150" y="28" width="132" height="224" rx="20" style="fill: var(--bg); stroke: var(--fg)" stroke-width="2" />
      <rect x="198" y="38" width="36" height="6" rx="3" style="fill: var(--line)" />
      <!-- "Ready to budget" banner -->
      <rect x="164" y="56" width="104" height="30" rx="8" style="fill: var(--accent-soft)" />
      <path d="M174 67 H220" style="stroke: var(--accent)" stroke-width="5" stroke-linecap="round" />
      <path d="M174 77 H200" style="stroke: var(--accent)" stroke-width="4" stroke-linecap="round" opacity="0.6" />
      <!-- Category rows with progress bars -->
      <g stroke-linecap="round">
        <path d="M166 102 H206" style="stroke: var(--muted)" stroke-width="5" opacity="0.45" />
        <path d="M244 102 H266" style="stroke: var(--fg)" stroke-width="5" opacity="0.7" />
        <path d="M166 113 H266" style="stroke: var(--line)" stroke-width="4" />
        <path d="M166 113 H236" style="stroke: var(--accent)" stroke-width="4" />

        <path d="M166 134 H196" style="stroke: var(--muted)" stroke-width="5" opacity="0.45" />
        <path d="M248 134 H266" style="stroke: var(--fg)" stroke-width="5" opacity="0.7" />
        <path d="M166 145 H266" style="stroke: var(--line)" stroke-width="4" />
        <path d="M166 145 H208" style="stroke: var(--accent)" stroke-width="4" />

        <path d="M166 166 H214" style="stroke: var(--muted)" stroke-width="5" opacity="0.45" />
        <path d="M240 166 H266" style="stroke: var(--fg)" stroke-width="5" opacity="0.7" />
        <path d="M166 177 H266" style="stroke: var(--line)" stroke-width="4" />
        <path d="M166 177 H258" style="stroke: var(--accent)" stroke-width="4" />

        <path d="M166 198 H190" style="stroke: var(--muted)" stroke-width="5" opacity="0.45" />
        <path d="M250 198 H266" style="stroke: var(--fg)" stroke-width="5" opacity="0.7" />
        <path d="M166 209 H266" style="stroke: var(--line)" stroke-width="4" />
        <path d="M166 209 H186" style="stroke: var(--accent)" stroke-width="4" />
      </g>
      <!-- Floating add button -->
      <circle cx="256" cy="232" r="11" style="fill: var(--accent)" />
      <path d="M256 227 V237 M251 232 H261" style="stroke: var(--bg)" stroke-width="2.4" stroke-linecap="round" />
    </g>

    <!-- Two-way sync -->
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M306 116 C360 92 414 92 466 116" style="stroke: var(--accent)" stroke-width="2.5" />
      <path d="M458 106 L467 116 L455 121" style="stroke: var(--accent)" stroke-width="2.5" />
      <path d="M466 164 C414 188 360 188 306 164" style="stroke: var(--muted)" stroke-width="2.5" stroke-dasharray="2 7" />
      <path d="M314 174 L305 164 L317 159" style="stroke: var(--muted)" stroke-width="2.5" />
    </g>
    <!-- Lock: encrypted sync -->
    <g>
      <rect x="374" y="128" width="24" height="20" rx="4" style="fill: var(--surface); stroke: var(--fg)" stroke-width="1.8" />
      <path d="M379 128 V123 C379 115 393 115 393 123 V128" fill="none" style="stroke: var(--fg)" stroke-width="1.8" />
      <circle cx="386" cy="138" r="2.2" style="fill: var(--fg)" />
    </g>

    <!-- Server -->
    <g>
      <rect x="490" y="72" width="112" height="40" rx="10" style="fill: var(--bg); stroke: var(--fg)" stroke-width="2" />
      <rect x="490" y="120" width="112" height="40" rx="10" style="fill: var(--bg); stroke: var(--fg)" stroke-width="2" />
      <rect x="490" y="168" width="112" height="40" rx="10" style="fill: var(--bg); stroke: var(--fg)" stroke-width="2" />
      <g stroke-linecap="round" stroke-width="5">
        <path d="M506 92 H546" style="stroke: var(--muted)" opacity="0.45" />
        <path d="M506 140 H556" style="stroke: var(--muted)" opacity="0.45" />
        <path d="M506 188 H536" style="stroke: var(--muted)" opacity="0.45" />
      </g>
      <circle cx="584" cy="92" r="4.5" style="fill: var(--accent)" />
      <circle cx="584" cy="140" r="4.5" style="fill: var(--accent)" />
      <circle cx="584" cy="188" r="4.5" style="fill: var(--accent)" opacity="0.5" />
    </g>
  </svg>
  {
    !bare && (
      <figcaption class="mt-3 text-center text-sm text-muted">
        Actua keeps a full copy of the budget on the phone and syncs every change with your own Actual Budget server.
      </figcaption>
    )
  }
</figure>
