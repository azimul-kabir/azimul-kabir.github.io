---
import { Image } from 'astro:assets';
import ThemedImage from '~/components/ThemedImage.astro';
import { getEntry, render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import { projects } from '~/data/projects';
import { latestReleaseLabel, repoStats } from '~/lib/github';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const entry = await getEntry('projects', project.slug);
if (!entry) throw new Error(`Missing article: src/content/projects/${project.slug}.md`);
const { Content } = await render(entry);
const { tagline, gallery } = entry.data;

const stats = project.repo ? await repoStats(project.repo) : null;
const facts = [...entry.data.facts];
const releaseLabel = latestReleaseLabel(stats);
if (releaseLabel) facts.push({ label: 'Latest release', value: releaseLabel });

// Primary links (and GitHub) are buttons; the rest are a quieter row of text links.
const primaryLinks = project.links?.filter((l) => l.primary) ?? [];
const otherLinks = project.links?.filter((l) => !l.primary) ?? [];

const kind = project.upcoming ? 'Upcoming' : project.contribution ? 'Contribution' : project.repo ? 'Open source' : 'Private project';

// Image sizing for each gallery layout, inside the max-w-5xl gallery column.
const layouts = {
  wide: { grid: 'sm:grid-cols-2', widths: [480, 720, 1080], sizes: '(min-width: 1024px) 480px, (min-width: 640px) 50vw, 100vw' },
  phone: { grid: 'grid-cols-2 sm:grid-cols-4', widths: [240, 360, 540], sizes: '(min-width: 1024px) 230px, (min-width: 640px) 25vw, 50vw' },
  full: { grid: '', widths: [640, 1024, 1600], sizes: '(min-width: 1024px) 976px, 100vw' },
};
---

<Base title={project.name} description={tagline}>
  <article>
    <header class="container-wide pt-12 sm:pt-16">
      <a href="/projects" class="text-sm text-muted hover:text-fg">← Projects</a>
      <p class="eyebrow mt-6">{kind}</p>
      <h1 class="mt-4 font-serif text-4xl font-semibold tracking-tight sm:text-5xl">{project.name}</h1>
      <p class="mt-4 max-w-2xl font-serif text-2xl leading-snug text-muted">{tagline}</p>
      {
        project.links?.length || project.repo ? (
          <>
            <div class="mt-8 flex flex-wrap gap-3">
              {primaryLinks.map((l) => (
                <a href={l.href} class="btn btn-primary" rel="noopener">
                  {l.label}
                </a>
              ))}
              {project.repo && (
                <a
                  href={`https://github.com/${project.repo}`}
                  class:list={['btn', primaryLinks.length === 0 && 'btn-primary']}
                  rel="noopener"
                >
                  GitHub{stats && stats.stars > 0 ? ` · ★ ${stats.stars}` : ''}
                </a>
              )}
            </div>
            {otherLinks.length > 0 && (
              <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                {otherLinks.map((l) => (
                  <a href={l.href} class="text-muted underline decoration-line underline-offset-4 hover:text-fg" rel="noopener">
                    {l.label}
                  </a>
                ))}
              </p>
            )}
          </>
        ) : project.upcoming ? (
          <p class="mt-6 text-sm text-muted">Not released yet.</p>
        ) : (
          <p class="mt-6 text-sm text-muted">{project.privateNote ?? 'Private'}: the source code isn't public.</p>
        )
      }
    </header>

    {
      project.image && (
        <div class="container-wide mt-12">
          <ThemedImage
            src={project.image.src}
            srcDark={project.image.srcDark}
            alt={project.image.alt}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 1024px) 976px, 100vw"
            class="w-full rounded-2xl border border-line"
            loading="eager"
          />
        </div>
      )
    }

    {
      facts.length > 0 && (
        <div class="container-wide">
          <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-4">
            {facts.map((f) => (
              <div class="bg-surface p-4">
                <dt class="text-xs text-muted">{f.label}</dt>
                <dd class="mt-1 text-sm font-medium">{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    <div class="container-wide">
      <div class="prose mt-12 max-w-3xl text-[17px] prose-zinc dark:prose-invert prose-headings:font-serif prose-a:text-accent prose-code:before:content-none prose-code:after:content-none">
        <Content />
      </div>
    </div>

    {
      gallery.length > 0 && (
        <section class="container-wide mt-16" aria-labelledby="screenshots">
          <h2 id="screenshots" class="eyebrow">
            Screenshots
          </h2>
          {gallery.map((group) => (
            <div class="mt-6">
              {group.title && <h3 class="mb-3 font-serif text-xl font-semibold">{group.title}</h3>}
              <div class:list={['grid gap-4', layouts[group.layout].grid]}>
                {group.items.map((item) => (
                  <figure>
                    {[
                      { src: item.src, theme: item.dark ? 'dark:hidden' : '' },
                      ...(item.dark ? [{ src: item.dark, theme: 'hidden dark:block' }] : []),
                    ].map((v) => (
                      <a href={v.src.src} class:list={['block', v.theme]} aria-label={`Open full-size image: ${item.alt}`}>
                        <Image
                          src={v.src}
                          alt={item.alt}
                          widths={layouts[group.layout].widths}
                          sizes={layouts[group.layout].sizes}
                          class="w-full rounded-xl border border-line"
                        />
                      </a>
                    ))}
                    {item.caption && <figcaption class="mt-2 text-sm text-muted">{item.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
          ))}
        </section>
      )
    }
  </article>
</Base>
