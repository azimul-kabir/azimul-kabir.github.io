---
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '~/data/profile';

const nav = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/lab', label: 'Lab' },
];
const path = Astro.url.pathname;
---

<header class="container-page flex items-center justify-between gap-4 py-6">
  <a href="/" class="font-serif text-xl font-semibold tracking-tight" aria-label={`${profile.name}, home`}>
    {profile.shortName}<span class="text-accent">.</span>
  </a>
  <nav aria-label="Main" class="flex items-center gap-1 text-sm sm:gap-2">
    {
      nav.map((item) => {
        const active = path === item.href || path.startsWith(`${item.href}/`);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'rounded-full px-2.5 py-2 transition-colors hover:text-fg sm:px-3',
              active ? 'text-fg' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        );
      })
    }
    <ThemeToggle />
  </nav>
</header>
