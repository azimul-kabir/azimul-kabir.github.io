---
import { profile } from '~/data/profile';
import { social } from '~/data/social';
const year = new Date().getFullYear();
---

<footer class="container-page mt-24 border-t border-line py-10 text-sm text-muted">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {profile.name} · {profile.location}</p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {
        social
          .filter((s) => s.footer)
          .map((s) => (
            <li>
              <a href={s.href} class="hover:text-fg" rel="me noopener">
                {s.label}
              </a>
            </li>
          ))
      }
      <li><a href="/links" class="hover:text-fg">All links</a></li>
      <li><a href="/rss.xml" class="hover:text-fg">RSS</a></li>
    </ul>
  </div>
</footer>
