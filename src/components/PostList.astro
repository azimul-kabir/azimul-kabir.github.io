---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PostCover from '~/components/PostCover.astro';
import { formatDate, readingTime } from '~/lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

<ul class="divide-y divide-line border-y border-line">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}`} class="group grid gap-4 py-6 sm:grid-cols-[13rem_1fr] sm:items-center sm:gap-6">
          <span class="block overflow-hidden rounded-2xl transition-opacity group-hover:opacity-90">
            {post.data.cover ? (
              <PostCover cover={post.data.cover} />
            ) : post.data.thumb ? (
              <Image
                src={post.data.thumb}
                alt=""
                widths={[208, 416, 624]}
                sizes="(min-width: 640px) 208px, 100vw"
                class="aspect-[18/7] w-full rounded-2xl border border-line object-cover"
              />
            ) : (
              <span class="block aspect-[18/7] rounded-2xl border border-line bg-surface" />
            )}
          </span>
          <span>
            <span class="block font-serif text-lg leading-snug font-semibold group-hover:text-accent">
              {post.data.title}
            </span>
            <span class="mt-1 block text-[15px] text-muted">{post.data.description}</span>
            <span class="mt-2 block text-sm text-muted tabular-nums">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> ·{' '}
              {readingTime(post.body)}
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
