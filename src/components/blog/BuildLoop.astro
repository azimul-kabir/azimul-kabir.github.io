---
// The build-in-public cycle behind Actua: idea → issue → pull request → release → feedback → idea.
const steps = [
  { title: 'Idea', text: 'Something I or a user wants' },
  { title: 'Issue', text: 'Written down on GitHub' },
  { title: 'Pull request', text: 'The change, reviewed and tested' },
  { title: 'Release', text: 'Out to testers and users' },
  { title: 'Feedback', text: 'Discord, GitHub and Play' },
];
// Points on a circle for the five steps, starting at the top.
const cx = 180;
const cy = 150;
const r = 108;
const points = steps.map((_, i) => {
  const a = (-90 + i * 72) * (Math.PI / 180);
  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) };
});
---

<figure class="not-prose my-10">
  <div class="grid items-center gap-6 rounded-2xl border border-line bg-surface p-5 sm:grid-cols-[minmax(0,300px)_1fr] sm:p-6">
    <svg viewBox="0 0 360 300" class="mx-auto h-auto w-full max-w-[300px]" role="img" aria-labelledby="loop-title">
      <title id="loop-title">A loop: idea, issue, pull request, release, feedback, and back to idea.</title>
      <circle cx={cx} cy={cy} r={r} fill="none" style="stroke: var(--line)" stroke-width="2" />
      <circle
        cx={cx}
        cy={cy}
        r={r}
        fill="none"
        style="stroke: var(--accent)"
        stroke-width="2.5"
        stroke-dasharray="4 10"
        stroke-linecap="round"
      />
      {
        points.map((p, i) => (
          <g>
            <circle cx={p.x} cy={p.y} r="22" style="fill: var(--bg); stroke: var(--accent)" stroke-width="2" />
            <text
              x={p.x}
              y={p.y + 5}
              text-anchor="middle"
              style="fill: var(--fg); font: 600 15px var(--font-sans)"
            >
              {i + 1}
            </text>
          </g>
        ))
      }
      <text x={cx} y={cy - 4} text-anchor="middle" style="fill: var(--fg); font: 600 18px var(--font-serif)">
        Building
      </text>
      <text x={cx} y={cy + 18} text-anchor="middle" style="fill: var(--muted); font: 500 15px var(--font-serif)">
        in public
      </text>
    </svg>
    <ol class="space-y-3">
      {
        steps.map((s, i) => (
          <li class="flex gap-3">
            <span class="grid size-6 shrink-0 place-items-center rounded-full bg-accent-soft text-xs font-semibold">
              {i + 1}
            </span>
            <span>
              <span class="font-medium">{s.title}</span>
              <span class="text-sm text-muted"> · {s.text}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption class="mt-3 text-center text-sm text-muted">Every release feeds the next round of ideas.</figcaption>
</figure>
