---
// Release timeline for "The Journey of Actua", from the first alpha to 1.8.0 (dates from CHANGELOG.md).
const milestones = [
  { date: '5 Sep', title: 'First alpha', text: '0.1.0-alpha.1, the first installable build.' },
  { date: '5–8 Sep', title: '14 alpha builds', text: 'Getting the basics to work and sync.' },
  { date: '8–25 Sep', title: 'Over 40 betas', text: 'Testers, bug reports and a release almost every day.' },
  { date: '25 Sep', title: '1.0.0', text: 'The beta label comes off, 20 days after the first alpha.', major: true },
  { date: '30 Sep', title: '1.4.0', text: 'One consistent design across the app.' },
  { date: '13 Oct', title: '1.8.0', text: 'The 70th release.', major: true },
];
---

<figure class="not-prose my-10">
  <ol class="relative grid gap-0 sm:grid-cols-6">
    <span
      class="absolute top-[11px] bottom-[11px] left-[11px] w-px bg-line sm:top-[11px] sm:right-[8%] sm:bottom-auto sm:left-[8%] sm:h-px sm:w-auto"
      aria-hidden="true"></span>
    {
      milestones.map((m) => (
        <li class="relative flex gap-4 pb-6 sm:flex-col sm:items-center sm:gap-3 sm:px-1 sm:pb-0 sm:text-center">
          <span
            class:list={[
              'relative z-10 mt-0.5 grid size-[22px] shrink-0 place-items-center rounded-full border-2',
              m.major ? 'border-accent bg-accent' : 'border-accent bg-bg',
            ]}
            aria-hidden="true"
          >
            {m.major && <span class="size-2 rounded-full bg-bg" />}
          </span>
          <span>
            <span class="block text-xs font-medium tracking-wide text-muted uppercase">{m.date}</span>
            <span class="mt-0.5 block font-medium">{m.title}</span>
            <span class="mt-1 block text-sm leading-snug text-muted">{m.text}</span>
          </span>
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-5 text-center text-sm text-muted">From the first alpha to 1.8.0 in September and October 2026.</figcaption>
</figure>
